# ============================================================
# Team Directory — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# Google Service Account — paste the full JSON as a single-line string
# Get this from your GCP Console > IAM & Admin > Service Accounts > Keys
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Google Sheets — the spreadsheet ID from your sheet URL
# e.g. https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=1EcuPMHwOesU94o9R42aL2fbxVjQ5bHo6TlztsLvM0gI

# The exact tab name inside the spreadsheet (will be created if missing)
GOOGLE_SHEET_NAME=Team

# Google Drive — the folder ID where profile photos are uploaded
# e.g. https://drive.google.com/drive/folders/FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=1qIUPTaz8BwHA95dhE231rlgz5R9Q3_Fv

# Editor sharing token — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anyone with this token can add/edit/delete entries.
# To revoke access, change this value and redeploy.
EDITOR_TOKEN=your-secret-editor-token-here

# Base URL of this deployment (no trailing slash)
# For local dev: http://localhost:3000
# For Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth 2.0 (Web Client) for Google Drive Photo Storage
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Automatically set after visiting /api/auth/google to authorize:
GOOGLE_OAUTH_REFRESH_TOKEN=
